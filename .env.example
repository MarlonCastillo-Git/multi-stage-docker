# Copie/generate con ./scripts/setup.sh. Nunca publique .env.
# Puertos del host (MySQL solo está disponible en la red interna).
FRONTEND_PORT=3000
BACKEND_PORT=8000
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
# Generar con openssl rand -base64 32 y prefijo base64:.
APP_KEY=
# Secreto JWT: openssl rand -hex 32.
JWT_SECRET=
MYSQL_DATABASE=ecommerce
MYSQL_USER=ecommerce
# Contraseñas independientes, generadas por setup.sh.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# true solo para los tres productos de demostración; sin usuarios predeterminados.
SEED_DEMO=true
# Opcionales: Stripe en modo prueba. La clave pública se incorpora durante build.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
